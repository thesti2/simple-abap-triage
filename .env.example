# Copy to .env and fill in. .env is git-ignored; never commit real values.
# LLM (OpenRouter)
OPENROUTER_API_KEY=
MODEL=
# LangSmith
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=
LANGSMITH_ENDPOINT=
# GCP
GCP_PROJECT_ID=
TF_STATE_BUCKET=
# SAP / project identifiers (shown as <PLACEHOLDER> in the docs)
SAP_ADT_DESTINATION=
SAP_DEV_SID=
SAP_CLIENT=
SAP_USER=
SAP_PACKAGE=
SAP_PHASE1_TR=
SAP_UAT_SID=
# Slack (docs/slack-setup.md)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=
SLACK_APP_TOKEN=
# xMatters -> backend webhook token (header X-Triage-Token)
XMATTERS_WEBHOOK_TOKEN=
# Optional: DATABASE_URL (default sqlite:///./triage.db; fix worker via Cloud SQL Auth Proxy:
#   postgresql+psycopg://triage:<pw>@127.0.0.1:5432/triage), SLACK_MODE (socket|http|off)
# Cloud Run only (set by Terraform): DB_SOCKET, DB_NAME, DB_USER, DB_PASSWORD
# Fix worker -> backend worker API over HTTPS (instead of DATABASE_URL); values from terraform output
TRIAGE_API_URL=
WORKER_API_TOKEN=
# Local Eclipse ADT MCP server used by the fix worker (Authorization header value)
SAP_ADT_MCP_URL=
SAP_ADT_MCP_AUTH=
# SAP GUI for HTML (WebGUI): real before/after screenshots in the fix test document.
# Full URL incl. client, e.g. https://<host>:<port>/sap/bc/gui/sap/its/webgui?sap-client=<client>
# Use a test/technical dialog user if possible. Leave empty to keep the text-rendered screenshots.
SAP_WEBGUI_URL=
SAP_WEBGUI_USER=
SAP_WEBGUI_PASSWORD=
SAP_WEBGUI_LANGUAGE=EN
